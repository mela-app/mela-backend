# Copy to .env next to this file on the server (it's gitignored - never
# commit it).

LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7
LIVEKIT_CONTAINER_NAME=livekit

# Generate a pair with:
#   docker run --rm livekit/livekit-server:v1.13.7 generate-keys
# then put the same two values in the API's LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET (/usr/src/apps/mela/api/.env).
LIVEKIT_KEYS="<api-key>: <api-secret>"
