# Env for the Mela API. Copy to .env next to this file on the server
# (/usr/src/apps/mela/api/.env) and fill it in - it is gitignored, never
# commit it. Generate every secret with `openssl rand -hex 32`; the API
# refuses to start in production on a sample or short one.
#
# Compose does not expand ${...} inside an env_file, so every value here is
# spelled out. The POSTGRES_* and REDIS_* lines are there to document what
# DATABASE_URL and REDIS_URL point at - keep them in step by hand.

# --- Container ----------------------------------------------------------------
API_IMAGE=ghcr.io/<owner>/mela-backend:latest
API_CONTAINER_NAME=mela-api
API_MIGRATE_CONTAINER_NAME=mela-api-migrate
# Published on the host and listened on inside the container: the compose
# file maps API_PORT to itself, so PORT must be the same number.
API_PORT=6002
PORT=6002

# --- App ----------------------------------------------------------------------
NODE_ENV=production
# The admin console's public address - comma-separated for more than one.
CORS_ORIGIN=https://melaadmin.example.com
# Hops to trust for the client's real IP (the reverse proxy in front: 1).
# The audit log and the rate limits depend on this being right.
TRUST_PROXY=1

# --- Shared Postgres (/usr/src/apps/infra/postgres) ---------------------------
# Mela's own database on the shared server - see infra/postgres/README.md in
# this repository for creating it.
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mela_system
POSTGRES_USER=mela_system_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mela_system_user:change-me@postgres:5432/mela_system?schema=public

# --- Shared Redis (/usr/src/apps/infra/redis) ---------------------------------
REDIS_CONTAINER_NAME=redis
REDIS_URL=redis://redis:6379

# --- Tokens (SECRET) ----------------------------------------------------------
# Two different random values, 32 characters or more.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SECONDS=604800

# --- Video --------------------------------------------------------------------
# Which provider NEW lives use: agora | livekit. A live keeps the provider
# it started on, so switching this never cuts off a running stream.
# The default for new lives; a super admin can switch it in the console
# (System > Video), which then wins. Set up both providers to switch.
VIDEO_PROVIDER=livekit

# Agora - needed to use it, or switch to it from the console (SECRET: the certificate).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Agora's usage report for the console's Video page: exact used minutes
# (Agora console > RESTful API; SECRET: both).
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# LiveKit, from infra/livekit on this server. LIVEKIT_URL is what the apps
# connect to, through the TLS proxy. LIVEKIT_API_URL is how this container
# reaches it: LiveKit uses host networking, so it goes through the host
# gateway, not a container name.
LIVEKIT_URL=wss://melalivekit.example.com
LIVEKIT_API_URL=http://host.docker.internal:7880
# The same pair as LIVEKIT_KEYS in infra/livekit/.env (SECRET: the secret).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: how long viewers' apps hold video before showing it, so a weak
# connection plays smoothly instead of freezing (LiveKit's playout delay, for
# lives started afterwards). Blank: 400 and 2000. MIN 0 turns it off.
LIVEKIT_MIN_PLAYOUT_DELAY_MS=
LIVEKIT_MAX_PLAYOUT_DELAY_MS=

# --- Object storage for avatars and chat photos (SECRET: the keys) ------------
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_URL_BASE=https://media.example.com
S3_BUCKET=avatars
# R2 uses "auto"; AWS its bucket's region.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Push notifications -------------------------------------------------------
# noop | fcm. With noop, pushes are logged rather than sent; in-app delivery
# and the inbox work either way.
PUSH_PROVIDER=noop
# With fcm: put the service-account JSON in ./secrets/firebase.json next to
# the compose file (mounted read-only at /app/secrets) and point here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Sign-up (Firebase verifies Google accounts and emailed links) ----------
# Required: the Firebase project id (as in the app's google-services.json).
FIREBASE_PROJECT_ID=
# The web player's Continue with Google (the Firebase Web app's public config).
# Blank: the player sends people to the app to sign up.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# Blank: <project id>.firebaseapp.com.
FIREBASE_AUTH_DOMAIN=

# --- Share links & deep links -------------------------------------------------
APP_URL_SCHEME=gamblinglive
ANDROID_APP_PACKAGE_NAME=com.gamblinglive.app
# Fill these once the app is signed for release, for verified app links.
ANDROID_APP_SHA256_FINGERPRINT=
APPLE_APP_ID=
# Where the share page's "Get the app" goes. Blank: Android falls back to
# the Play Store listing for ANDROID_APP_PACKAGE_NAME; iOS gets no link.
ANDROID_INSTALL_URL=
IOS_INSTALL_URL=

# Early access (Google Play closed test): the testers' Google Group. Set, a
# phone without Mela that opens a shared live or profile gets the steps on
# /get-mela - join the group, become a tester, install - and comes back to
# what was shared. Blank once Mela is public: the store listing instead.
# ANDROID_TESTER_OPT_IN_URL blank: https://play.google.com/apps/testing/<package>.
# See docs/features/share.md, "Early access".
ANDROID_TESTER_GROUP_URL=
ANDROID_TESTER_OPT_IN_URL=


# Where people write to have their account deleted without the app, shown on
# /delete-account - the page Google Play's Data safety form asks for. Blank: the
# page only explains how to delete it in the app.
SUPPORT_EMAIL=

# Who runs Mela, as the Terms of Service and Privacy Policy (/terms,
# /privacy) name them - e.g. the company. Blank: "Mela". The contact on both
# pages is SUPPORT_EMAIL. See docs/features/legal.md.
LEGAL_OPERATOR_NAME=Mela

# --- Moderation ---------------------------------------------------------------
# Live chat blocks every link except to these domains and their subdomains
# (comma-separated). Empty: no links at all.
CHAT_LINK_DOMAINS=

# --- Admin console ------------------------------------------------------------
# The first super admin, created by the migrate job if it doesn't exist. The
# password is temporary - the console makes you choose a new one at first
# sign-in, and re-seeding never resets an existing account's password. At
# least 12 characters, with letters and numbers. Clear it once it's used.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# A console sign-in lasts at most this long, however active (12 hours).
ADMIN_SESSION_MAX_AGE_SECONDS=43200
