# HTTPS for Mela (infra/production/docker-compose.yml). Certificates come
# from Let's Encrypt automatically once DNS points here and 80/443 are open.
{
	email {$ACME_EMAIL}
	# Caddy runs in a container: nothing to add to a system trust store.
	skip_install_trust
}

# The API: the apps, Socket.IO, share pages (/live/:id) and /.well-known -
# plus the web player those pages load (/web/*, its own container). The API
# compresses its own responses.
{$API_DOMAIN} {
	handle /web/* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# The admin console (its nginx proxies /v1 to the API).
{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# LiveKit signaling (`--profile livekit`).
{$LIVEKIT_DOMAIN} {
	reverse_proxy 127.0.0.1:7880
}
