# Mela production settings - copy to .env next to docker-compose.yml and fill
# in (docs/deployment.md). Never commit .env. Random values:
#   openssl rand -hex 32

# --- Domains: DNS A/AAAA records pointing at this server --------------------
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Only with VIDEO_PROVIDER=livekit and COMPOSE_PROFILES=livekit below.
LIVEKIT_DOMAIN=livekit.example.com
# Let's Encrypt account: certificate expiry notices go here.
ACME_EMAIL=ops@example.com

# --- Database (internal only). Letters and digits only - it goes into a URL.
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------
# Two different random values of at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Video for new lives: agora | livekit (docs/features/video-provider.md).
VIDEO_PROVIDER=livekit
# Running LiveKit on this server too? Set this to `livekit` so a plain
# `docker compose up -d` brings it up with everything else, and later compose
# commands here don't leave it behind. Leave it empty otherwise.
COMPOSE_PROFILES=livekit
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# LiveKit on this server: a pair from
#   docker run --rm livekit/livekit-server:v1.13.7 generate-keys
# (the livekit service is configured with the same pair).
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Avatars: an S3-compatible bucket (AWS S3, Cloudflare R2, ...) that the apps
# upload to directly and read through S3_PUBLIC_URL_BASE (docs/features/storage.md).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL_BASE=https://media.example.com
S3_BUCKET=avatars
# R2: "auto"; AWS: the bucket's region. Required.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The console may show avatars from there; must match S3_PUBLIC_URL_BASE's origin.
ADMIN_CSP_IMG_SRC=https://media.example.com

# Push notifications: noop | fcm (docs/features/notifications.md).
PUSH_PROVIDER=noop
FIREBASE_SERVICE_ACCOUNT_JSON=

# Share links and app links (docs/features/share.md).
APP_URL_SCHEME=gamblinglive
ANDROID_APP_PACKAGE_NAME=com.gamblinglive.app
ANDROID_APP_SHA256_FINGERPRINT=
APPLE_APP_ID=
# Where the share page's "Get the app" goes. Android defaults to the Play
# Store listing for ANDROID_APP_PACKAGE_NAME; iOS shows no store link until
# there's an App Store listing to point at.
ANDROID_INSTALL_URL=
IOS_INSTALL_URL=
# Links to these domains (and their subdomains) are allowed in live chat;
# every other link is blocked.
CHAT_LINK_DOMAINS=example.com

# --- Admin console ------------------------------------------------------------
# The first super admin, created on the first deploy. The password is
# temporary (changed at first sign-in; at least 12 characters, letters and
# numbers) and is never used again once the account exists - clear it then.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
ADMIN_SESSION_MAX_AGE_SECONDS=43200

# --- Images -----------------------------------------------------------------
# What `docker compose pull` fetches. Each repository's cd.yml pushes its
# app's image to GHCR (owner lowercase) on main, tagged both `latest` and the
# commit SHA. Keep the tags at `latest` for automatic deploys; a SHA pins that
# one app (its deploys then no longer change it here). Unset BACKEND_IMAGE to
# build the API on the server instead.
BACKEND_IMAGE=ghcr.io/<owner>/mela-backend
ADMIN_IMAGE=ghcr.io/<owner>/mela-admin
WEB_IMAGE=ghcr.io/<owner>/mela-web
BACKEND_TAG=latest
ADMIN_TAG=latest
WEB_TAG=latest
