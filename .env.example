# Copy to .env (gitignored - never commit it) and adjust. The values below
# are for this machine. The API has no built-in addresses: it refuses to
# start while a required one is missing, naming it. Secrets are marked
# SECRET - use fresh random values anywhere but your own machine
# (`openssl rand -hex 32`).

# App
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the admin console's dev
# server here). Required - see docs/features/auth.md.
CORS_ORIGIN=http://localhost:5173
# Where the dev scripts (scripts/*.js) reach this API.
API_ORIGIN=http://localhost:3000

# Database (SECRET: the password inside)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gambling_live?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (SECRET)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL_SECONDS=604800

# Video provider for NEW lives: agora | livekit. A live keeps the provider
# it started on, so switching this never cuts off a running stream.
# See docs/features/video-provider.md.
VIDEO_PROVIDER=agora

# Agora - leave blank until you provision a real project (SECRET: the
# certificate). See docs/features/video-provider.md for what works without these.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# LiveKit (self-hosted). docker-compose.yml starts the local LiveKit server
# with this same key pair (as LIVEKIT_KEYS) - change both together (SECRET:
# the API secret). LIVEKIT_URL is what the apps connect to - wss://... in production.
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional: how the backend reaches LiveKit's API when that differs from
# LIVEKIT_URL (e.g. http://127.0.0.1:7880 when both run on one server).
LIVEKIT_API_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-for-local-development-only
# Optional: how long viewers' apps hold video before showing it, so a weak
# connection plays smoothly instead of freezing (LiveKit's playout delay, for
# lives started afterwards). Blank: 400 and 2000. MIN 0 turns it off.
LIVEKIT_MIN_PLAYOUT_DELAY_MS=
LIVEKIT_MAX_PLAYOUT_DELAY_MS=

# Object storage for avatars and chat photos - S3Mock in dev (`docker compose
# up -d s3mock`; the "avatars" bucket is created automatically on startup),
# S3/R2 in production (SECRET: the keys). See docs/features/storage.md.
S3_ENDPOINT=http://localhost:9090
S3_PUBLIC_URL_BASE=http://localhost:9090/avatars
S3_BUCKET=avatars
# Any value works for S3Mock; R2 uses "auto"; AWS its bucket's region.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# Push notifications (plan §6.11) - noop | fcm. Leave as noop until a real
# Firebase project exists; pushes are logged, not sent (in-app delivery and
# the inbox work fully either way). See docs/features/notifications.md.
PUSH_PROVIDER=noop
# A Firebase service-account JSON string, OR a path to that file (SECRET).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Sign-up (docs/features/auth.md): Firebase proves a Google account or an
# emailed link; Mela keeps the accounts. The project id is required (it's in
# the app's google-services.json too) - no service account needed for this.
FIREBASE_PROJECT_ID=
# The web player's Continue with Google: Firebase console > Project settings
# > Your apps > the Web app's config. Public values, not secrets. Blank: the
# player sends people to the app to sign up.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# Blank: <project id>.firebaseapp.com.
FIREBASE_AUTH_DOMAIN=

# Share links & deep links (plan §6.12). The custom scheme and the package
# name are the mobile app's own (required). GET /live/:id and the
# .well-known files work without a real domain. See docs/features/share.md.
APP_URL_SCHEME=gamblinglive
ANDROID_APP_PACKAGE_NAME=com.gamblinglive.app
# Leave blank until the app is signed for release - the .well-known routes
# return empty/placeholder content without these (harmless, just unverified).
ANDROID_APP_SHA256_FINGERPRINT=
APPLE_APP_ID=
# Where the share page's web player sends "Get the app". Blank: Android goes
# to the Play Store listing for ANDROID_APP_PACKAGE_NAME; iOS gets no store
# link until there's an App Store listing.
ANDROID_INSTALL_URL=
IOS_INSTALL_URL=

# Where people write to have their account deleted without the app, shown on
# /delete-account - the page Google Play's Data safety form asks for. Blank: the
# page only explains how to delete it in the app.
SUPPORT_EMAIL=

# Live chat blocks every link except to these domains and their subdomains
# (comma-separated) - the platform's own, once it has one. Empty: no links.
# See docs/features/moderation.md.
CHAT_LINK_DOMAINS=

# Admin console (docs/features/admin.md)
# `npm run db:seed` creates this super admin if it doesn't exist yet. The
# password is temporary: the console makes you choose a new one at first
# sign-in, and re-seeding never resets an existing account's password.
# At least 12 characters, with letters and numbers. Without an email, the
# seed creates nobody. (SECRET: the password - clear it once it's used.)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# A console sign-in lasts at most this long, however active (12 hours).
ADMIN_SESSION_MAX_AGE_SECONDS=43200
# Set behind a reverse proxy so the audit log records real client IPs
# (e.g. 1 for one proxy hop). Leave blank when clients connect directly.
TRUST_PROXY=

# --- Docker (docker-compose.yml reads this file too) --------------------------
# The local database's password - the same one DATABASE_URL uses above.
POSTGRES_PASSWORD=postgres
# `--profile app`: the port the API container is published on here.
BACKEND_PORT=3000

